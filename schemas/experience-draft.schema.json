{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/exe-product-lifecycle/experience-draft.schema.json",
  "title": "Product-local reusable experience draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "summary", "category", "tags", "evidence_level", "pattern"],
  "properties": {
    "schema_version": { "const": 1 },
    "title": { "type": "string", "minLength": 8, "maxLength": 120 },
    "summary": { "type": "string", "minLength": 20, "maxLength": 500 },
    "category": {
      "enum": ["intake", "packaging", "runtime", "ui", "authorization", "update", "migration", "tooling", "release"]
    },
    "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,31}$" } },
    "evidence_level": {
      "enum": ["static_present", "entrypoint_present", "locally_exercised", "dynamic_success", "failure_observed"]
    },
    "pattern": { "$ref": "#/$defs/pattern" }
  },
  "$defs": {
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicability", "detection", "negative_indicators", "procedure", "verification", "rollback", "failure_signals", "stop_conditions", "limitations"],
      "properties": {
        "applicability": { "$ref": "#/$defs/nonEmptyStrings" },
        "detection": { "$ref": "#/$defs/nonEmptyStrings" },
        "negative_indicators": { "$ref": "#/$defs/nonEmptyStrings" },
        "procedure": { "$ref": "#/$defs/nonEmptyStrings" },
        "verification": { "$ref": "#/$defs/nonEmptyStrings" },
        "rollback": { "$ref": "#/$defs/nonEmptyStrings" },
        "failure_signals": { "$ref": "#/$defs/nonEmptyStrings" },
        "stop_conditions": { "$ref": "#/$defs/nonEmptyStrings" },
        "limitations": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3, "maxLength": 500 }
    }
  }
}
